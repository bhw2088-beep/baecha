// GitHub Codespaces · VS Code Dev Containers 설정
// 저장소 → Code → Codespaces → Create codespace on main 을 누르면:
//   1) .env 가 없으면 .env.example 로 만들고 (Codespaces Secrets 의 NTS_API_KEY · GEMINI_API_KEY 가 있으면 넣어 줌)
//   2) docker compose up --build -d 로 6개 서비스를 띄우고
//   3) 웹 화면(8501)을 브라우저 탭으로 연다 (처음 빌드는 5~10분)
// 포트는 기본 '나만 보기(Private)'. 다른 사람에게 보여 주려면 PORTS 탭 → 8501 → Port Visibility → Public.
{
  "name": "배차의 민족",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "docker compose up --build -d",
  "forwardPorts": [8501, 8000],
  "portsAttributes": {
    "8501": {"label": "웹 화면 (화주 · 차주 · 관제)", "onAutoForward": "openBrowser"},
    "8000": {"label": "API · 휴대폰 3D 가이드 (/m/)", "onAutoForward": "notify"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-containers"]
    }
  }
}
