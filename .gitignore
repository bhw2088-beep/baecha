# 비밀값 · 로컬 환경
.env
.venv*/

# 파이썬 캐시
__pycache__/
*.pyc
.pytest_cache/

# 발표 · 내부 정리용 문서 (공유하지 않음)
docs/internal/

# 인수증 사진 (운영 데이터)
backend/data/pod_photos/

# 스트레스 테스트 실행 로그 (결과 JSON · CSV · summary.md 는 커밋)
tests/stress/stress_8k/results/logs/

# 에디터 (8,000+ 스트레스 테스트 실행 목록 launch.json 만 공유)
.vscode/*
!.vscode/launch.json

# 통합 시뮬레이터 결과 (시각별 사본은 커밋 안 함 · mode<N>_latest.json 만 커밋)
scripts/results/mode*_2*.json
