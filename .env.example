# 배차의 민족 환경변수 템플릿
# 처음 한 번: 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 값을 바꾸세요.
#   copy .env.example .env
# .env 는 비밀번호가 들어 있으므로 git 에 올리지 않습니다 (.gitignore).

# ---- PostgreSQL + PostGIS (docker-compose 의 db 컨테이너) ----
POSTGRES_USER=baecha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baecha

# 로컬(도커 밖)에서 백엔드를 실행할 때 쓰는 주소.
# 도커로 실행하면 docker-compose.yml 이 컨테이너 주소(db, redis)로 바꿔 넣습니다.
DATABASE_URL=postgresql+psycopg://baecha:change-me@localhost:5432/baecha
REDIS_URL=redis://localhost:6379/0

# ---- 앱 설정 ----
ADMIN_APPROVAL_CODE=CT-ADMIN-2026
TIME_SCALE=20

# ---- 시뮬레이터 (simulator 컨테이너 → 백엔드 내부 API · GPS 핑) ----
SIM_API_KEY=change-me-sim
# 고의 경로 이탈 시나리오 주기(초, 0 이면 끔) · 재위탁 핑 시나리오 주기(초, 0 이면 끔)
SIM_DEVIATION_EVERY=240
SIM_REOUTSOURCE_EVERY=0

# ---- 외부 연동 (비워 두면 모의 · 규칙 기반으로 동작) ----
# 국세청 사업자 진위확인: data.go.kr '국세청_사업자등록정보 진위확인 및 상태조회 서비스' 인증키(Decoding)
NTS_API_KEY=
# Google Gemini (AI 관제 자연어 명령): https://aistudio.google.com 에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- 엔진 기준값 (기본값 그대로 두면 됨) ----
ML_THRESHOLD=0.75
SAFETY_MARGIN=0.05
TOP_LOAD_MARGIN=0.10
DEVIATION_KM=1.0
DEVIATION_HITS=3
DELAY_ALERT_MIN=30

# ---- 시연 ----
# 1 = 하차지에 도착한 운행을 자동으로 하차 완료 → 기사가 하차지에서 다음 배차를 기다림 (개발용 compose 기본 1)
# 0 = 기사가 차주 화면에서 직접 [하차 완료]를 눌러야 끝남 (직접 누르는 장면을 시연할 때)
DEMO_AUTO_DELIVER=1
