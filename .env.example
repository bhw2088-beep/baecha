# 배차의 민족 환경변수 템플릿
# 처음 한 번: 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 값을 바꾸세요.
#   copy .env.example .env
# .env 는 비밀번호가 들어 있으므로 git 에 올리지 않습니다 (.gitignore).

# ---- PostgreSQL + PostGIS (docker-compose 의 db 컨테이너) ----
POSTGRES_USER=baecha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baecha

# 로컬(도커 밖)에서 백엔드를 실행할 때 쓰는 주소.
# 도커로 실행하면 docker-compose.yml 이 컨테이너 주소(db, redis)로 바꿔 넣습니다.
DATABASE_URL=postgresql+psycopg://baecha:change-me@localhost:5432/baecha
REDIS_URL=redis://localhost:6379/0

# ---- 앱 설정 ----
ADMIN_APPROVAL_CODE=CT-ADMIN-2026
TIME_SCALE=20

# ---- 시뮬레이터 (simulator 컨테이너 → 백엔드 내부 API) ----
SIM_API_KEY=change-me-sim
